{
  "name": "subutai-dl",
  "version": "0.1.0",
  "private": true,
  "description": "Subutai Download Manager monorepo",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @subutai/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:native-policy": "node scripts/native-engine-policy-test.mjs",
    "test:native-engine": "pnpm test:native-policy && cargo fmt --manifest-path engines/native/Cargo.toml --all -- --check && cargo clippy --manifest-path engines/native/Cargo.toml --all-targets --features failure-injection -- -D warnings && cargo test --manifest-path engines/native/Cargo.toml --all-targets --features failure-injection && cargo run --quiet --manifest-path engines/native/Cargo.toml --bin subutai-engine -- self-test",
    "test:direct": "node scripts/direct-download-smoke.mjs",
    "test:media": "node scripts/media-smoke.mjs",
    "test:queue": "node --experimental-strip-types scripts/queue-policy-test.mts",
    "test:transfer": "node --experimental-strip-types scripts/transfer-policy-test.mts",
    "test:batch": "node --experimental-strip-types scripts/batch-expander-test.mts",
    "test:failure-policy": "node --experimental-strip-types scripts/failure-policy-test.mts",
    "test:resilience": "node scripts/resilience-download-test.mjs",
    "test:native-soak": "node scripts/native-soak-benchmark.mjs",
    "test:clipboard": "node --experimental-strip-types scripts/clipboard-policy-test.mts",
    "test:site-grabber": "node --experimental-strip-types scripts/site-grabber-test.mts",
    "test:system": "node --experimental-strip-types scripts/system-policy-test.mts",
    "test:integrity": "node --experimental-strip-types scripts/integrity-policy-test.mts",
    "test:mirror": "node --experimental-strip-types scripts/mirror-policy-test.mts",
    "test:telemetry": "node --experimental-strip-types scripts/telemetry-policy-test.mts",
    "test:production-acceptance": "node scripts/production-acceptance-policy-test.mjs",
    "test:release-version": "node scripts/validate-release-version.mjs",
    "test:release-engine": "node scripts/release-engine-policy-test.mjs",
    "test:dependency-lock": "node scripts/dependency-lock-policy-test.mjs",
    "test:brand": "node scripts/brand-policy-test.mjs"
  }
}
