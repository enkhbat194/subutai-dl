{
  "manifest_version": 3,
  "name": "Subutai Download Manager Integration",
  "version": "0.1.0",
  "description": "Send browser downloads, links, media, cookies and request context to Subutai Download Manager.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "notifications",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Subutai",
    "default_popup": "popup.html"
  }
}
