{
  "name": "@subutai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Subutai Download Manager desktop application",
  "author": "enkhbat194",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win nsis portable",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@subutai/shared": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.subutai.downloadmanager",
    "productName": "Subutai Download Manager",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/engines/win32-x64",
        "to": "engines",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "Subutai-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Subutai Download Manager",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Subutai-Portable-${version}-${arch}.${ext}"
    }
  }
}
